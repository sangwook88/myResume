ANTHROPIC_API_KEY=my-secret-anthropic-api-key

# (선택) 챗봇 RAG 마스터 스위치. 기본 OFF — 챗봇은 항상 전량 load-all 로 답한다.
# 포폴 포인트가 충분히(대략 20+) 쌓여 load-all 이 부담될 때만 1 로 켠다.
# 켜기 전 반드시 인덱스를 빌드: cd backend && .venv/Scripts/python.exe scripts/build_rag_index.py
# CHAT_RAG_ENABLED=1

# ── 챗봇 남용 방지(레이트리밋/밴) + 질문 로깅 ── (모두 Redis, 선택·기본값 있음)
# 요금 폭탄 방지: IP 단위 분·일 한도 + 같은 질문 반복(스팸) 시 일시 밴. LLM 호출 전 차단.
# CHAT_RATE_PER_MIN=20      # 분당 허용 질문(초과 시 지연 요청 안내)
# CHAT_RATE_PER_DAY=300     # 하루 허용 질문(비용 상한)
# CHAT_DUP_THRESHOLD=3      # 같은 질문 N회째 반복 시 밴(기본 3 = 3번째에 밴)
# CHAT_OFFTOPIC_LIMIT=5     # 포트폴리오와 무관해 근거 못 찾은(거부) 답변 N회 연속 시 밴
# CHAT_BAN_SECONDS=3600     # 밴 지속(초)
# CHAT_TRUST_PROXY=0        # 리버스 프록시 뒤면 1 — X-Forwarded-For 첫 홉을 IP 로 신뢰
#
# 질문 분석 조회 엔드포인트(GET /api/chat/admin/questions · /admin/top)를 켜는 토큰.
# 미설정이면 관리자 엔드포인트는 404(비활성). 설정 시 헤더 Authorization: Bearer <토큰> 필요.
# CHAT_ADMIN_TOKEN=change-me-to-a-long-random-secret
