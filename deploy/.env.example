# docker compose 가 자동 로드하는 deploy/.env 의 예시.
# 실제 값으로 채워 `deploy/.env` 로 복사한다(deploy/.env 는 커밋 금지 — .gitignore 처리됨).

# [필수] 챗봇 답변 생성용 Claude 키. 없으면 backend 기동은 되나 챗봇이 답변 실패.
ANTHROPIC_API_KEY=sk-ant-...

# [필수] 배포 오리진.
#   :80          로컬/사설망 HTTP 테스트 → http://localhost
#   example.com  공개 도메인 → Caddy 가 HTTPS 자동(포트 443 개방 + DNS 필요)
SITE_ADDRESS=:80

# [선택] 질문 로그 관리자 조회 토큰(GET /api/chat/admin/questions|top 에 Bearer 로 사용).
#        비우면 해당 엔드포인트는 404 로 완전히 숨겨진다.
CHAT_ADMIN_TOKEN=
